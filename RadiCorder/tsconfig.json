{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "strict": true,
    "esModuleInterop": true,
    "moduleResolution": "node",
    "sourceMap": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "./wwwroot/js",
    "lib": [ "es2019", "dom" ]
  },
  "include": [
    "Scripts/**/*.ts"
  ],
  "exclude": [
    "Scripts/generated/**/*.ts"
  ]
}
